{
          "name": "server",
          "version": "1.0.0",
          "description": "",
          "main": "dist/index.js",
          "type": "module",
          "scripts": {
                    "predev": "node scripts/ensure-port-free.mjs && node scripts/ensure-local-mongo.mjs",
                    "dev": "nodemon",
                    "build": "tsc",
                    "typecheck": "tsc --noEmit",
                    "test": "vitest run",
                    "test:watch": "vitest",
                    "backfill:payments": "node scripts/backfill-order-payments.mjs",
                    "backfill:menus": "node scripts/backfill-menu-availability.mjs",
                    "prestart": "node scripts/ensure-port-free.mjs && node scripts/ensure-local-mongo.mjs",
                    "start": "npm run build && node dist/index.js",
                    "kill": "node scripts/stop-server.mjs",
                    "restart": "npm run kill && npm run dev",
                    "mongo:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-mongo.ps1",
                    "stripe": "stripe listen --forward-to localhost:8001/api/v1/order/webhook"
          },
          "keywords": [],
          "license": "ISC",
          "dependencies": {
                    "@types/bcryptjs": "^2.4.6",
                    "@types/cookie-parser": "^1.4.10",
                    "@types/cors": "^2.8.19",
                    "@types/express": "^4.17.21",
                    "@types/jsonwebtoken": "^9.0.10",
                    "@types/multer": "^1.4.11",
                    "@types/node": "^22.20.1",
                    "axios": "^1.18.1",
                    "bcryptjs": "^2.4.3",
                    "cloudinary": "^2.10.0",
                    "cookie-parser": "^1.4.7",
                    "cors": "^2.8.6",
                    "dotenv": "^16.6.1",
                    "express": "^4.22.2",
                    "express-rate-limit": "^8.7.1",
                    "helmet": "^8.3.0",
                    "ioredis": "^6.0.0",
                    "jsonwebtoken": "^9.0.3",
                    "mongoose": "^8.24.1",
                    "multer": "^1.4.5-lts.2",
                    "pino": "^10.4.0",
                    "pino-pretty": "^13.2.0",
                    "socket.io": "^4.8.3",
                    "socket.io-client": "^4.8.4",
                    "stripe": "^16.12.0",
                    "typescript": "^5.9.3",
                    "zod": "^4.6.7"
          },
          "devDependencies": {
                    "@types/express-rate-limit": "^5.1.3",
                    "@types/supertest": "^7.2.1",
                    "@vitest/coverage-v8": "^5.0.5",
                    "mongodb-memory-server": "^11.3.0",
                    "nodemon": "^3.1.14",
                    "supertest": "^7.3.1",
                    "tsx": "^4.19.0",
                    "vitest": "^5.0.5"
          }
}
