{
            "watch": [
                        "*.ts",
                        "config",
                        "routes",
                        "controller",
                        "models",
                        "middlewares",
                        "schemas",
                        "services",
                        "socketHandlers",
                        "utils",
                        "db",
                        "mailtrap"
            ],
            "ext": "ts,json",
            "ignore": [
                        "node_modules",
                        "dist",
                        "uploads"
            ],
            "exec": "node --import tsx index.ts",
            "env": {
                        "NODE_ENV": "development"
            },
            "signal": "SIGTERM",
            "delay": "1000"
}