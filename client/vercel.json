{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://food-delivery-backend-3dwa.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://food-delivery-backend-3dwa.onrender.com/health"
    },
    {
      "source": "/socket.io",
      "destination": "https://food-delivery-backend-3dwa.onrender.com/socket.io"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://food-delivery-backend-3dwa.onrender.com/socket.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/health",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/socket.io/(.*)",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(self)"
        }
      ]
    }
  ]
}
